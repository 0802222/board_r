# JWT (만료 시간: 밀리초)
JWT_SECRET=change-me-base64-string-48-bytes
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# MySQL 컨테이너 (docker-compose의 mysql 서비스가 읽음)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=board

# 로컬 실행 (IntelliJ, docker-compose의 mysql은 호스트 3307 포트)
JDBC_DATABASE_URL_LOCAL=jdbc:mysql://localhost:3307/board
JDBC_DATABASE_USERNAME_LOCAL=root
JDBC_DATABASE_PASSWORD_LOCAL=change-me

# docker-compose app / dev 프로파일
JDBC_DATABASE_URL=jdbc:mysql://mysql:3306/board
JDBC_DATABASE_USERNAME=root
JDBC_DATABASE_PASSWORD=change-me

# 메일
MAIL_USERNAME=
MAIL_PASSWORD=
